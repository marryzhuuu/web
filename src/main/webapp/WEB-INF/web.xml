<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="4.0">

    <display-name>Area Check Application</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>ControllerServlet</servlet-name>
        <servlet-class>controller.ControllerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ControllerServlet</servlet-name>
        <url-pattern>/controller/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AreaCheckServlet</servlet-name>
        <servlet-class>controller.AreaCheckServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AreaCheckServlet</servlet-name>
        <url-pattern>/calculate/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PointsServlet</servlet-name>
        <servlet-class>controller.PointsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PointsServlet</servlet-name>
        <url-pattern>/points/*</url-pattern>
    </servlet-mapping>

</web-app>